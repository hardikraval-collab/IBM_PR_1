# DIP Diet RAG Agent — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL DEV:  Copy this file to dip_diet_agent/.env and fill in your values.
# RENDER:     Set these in the Render dashboard → Environment tab.
#             NEVER commit a .env file containing real credentials to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── IBM WatsonX Configuration ─────────────────────────────────────────────────
# API key: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Project ID: WatsonX.ai Studio → Project Settings → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# WatsonX endpoint (default: us-south)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model ID
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Embedding Model ───────────────────────────────────────────────────────────
# Local HuggingFace sentence-transformers model — no API key needed.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── RAG Settings ─────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=4
CHROMA_COLLECTION_NAME=dip_diet_kb

# ── LLM Generation Settings ───────────────────────────────────────────────────
LLM_MAX_NEW_TOKENS=800
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
LLM_REPETITION_PENALTY=1.1

# ── Server Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Set DEBUG=false in production
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Leave as "*" when the frontend is served by the same FastAPI process (default).
# Set to your Render URL if you ever split frontend/backend:
#   ALLOWED_ORIGINS=https://dip-diet-rag-agent.onrender.com
ALLOWED_ORIGINS=*
