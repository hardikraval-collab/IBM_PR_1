# DIP Diet RAG Agent — Environment Variables
# Copy this file to .env and fill in your values

# ── IBM WatsonX Configuration ─────────────────────────────────────────────────
# Get from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Get from: https://us-south.ml.cloud.ibm.com (WatsonX.ai Studio > Project Settings)
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# WatsonX endpoint (default: us-south)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite Model ID
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Embedding Model ───────────────────────────────────────────────────────────
# Local sentence-transformers model (no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── RAG Settings ─────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=4
CHROMA_COLLECTION_NAME=dip_diet_kb

# ── LLM Generation Settings ───────────────────────────────────────────────────
LLM_MAX_NEW_TOKENS=800
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
LLM_REPETITION_PENALTY=1.1

# ── Server Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
