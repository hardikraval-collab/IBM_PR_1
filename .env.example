# DIP Diet RAG Agent — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it is listed in .gitignore.

# ── IBM WatsonX Configuration ─────────────────────────────────────────────────
# Obtain from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# Obtain from: WatsonX.ai Studio → Project Settings → General
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# WatsonX regional endpoint (default: us-south)
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# IBM Granite model identifier
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Embedding Model ───────────────────────────────────────────────────────────
# Local sentence-transformers model — no API key required
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── RAG Settings ──────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K_RESULTS=4
CHROMA_COLLECTION_NAME=dip_diet_kb

# ── LLM Generation Settings ───────────────────────────────────────────────────
LLM_MAX_NEW_TOKENS=800
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.95
LLM_REPETITION_PENALTY=1.1

# ── Server Configuration ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
